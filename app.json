{
  "expo": {
    "name": "lost-person-alert",
    "slug": "lost-person-alert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "lostpersonalert",
      "com.googleusercontent.apps.389857812215-vdig4mm0b4luri0biam5f5bi5pb0o7ls"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.lostpersonalert",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs your location to show missing persons in your area and help track them."
      }
    },
    "android": {
      "package": "com.yourname.lostpersonalert",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "lostpersonalert",
              "host": "auth"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "com.googleusercontent.apps.389857812215-vdig4mm0b4luri0biam5f5bi5pb0o7ls"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E6F4FE"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Lost Person Alert to use your location to show missing persons in your area.",
          "locationAlwaysAndWhenInUsePermission": "Allow Lost Person Alert to use your location to show nearby missing persons.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "minSdkVersion": 24
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d177a10-9843-444b-ba07-c806bb99993e"
      }
    }
  }
}